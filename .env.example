# .env.example

# Core
SYMBOL=BTCUSDT
DEPTH_LIMIT=200
REDIS_URL=redis://redis:6379/0
POSTGRES_DSN=postgresql://postgres:postgres@postgres:5432/liquidation
PUBLISH_BATCH_SIZE=50
PUBLISH_BATCH_INTERVAL=1.0

# Hyperliquid
HYPERLIQUID_BASE_URL=https://api.hyperliquid.xyz
HYPERLIQUID_FUNDING_PATH=/info
HYPERLIQUID_OI_PATH=/info
HYPERLIQUID_POLL_INTERVAL=5
HYPERLIQUID_TIMEOUT=5
HYPERLIQUID_RETRIES=3
HYPERLIQUID_SYMBOLS=BTC,ETH,SOL
HYPERLIQUID_API_KEY=
HYPERLIQUID_API_SECRET=
